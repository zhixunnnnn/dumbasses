# Copy to backend/.env (git-ignored) and fill in. Never commit real secrets.

# --- Bright Data: pick ONE mode ---
# Mode A — API token (Web Unlocker / Scraper API):
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_KEY_FALLBACK=
BRIGHTDATA_ZONE=web_unlocker1
BRIGHTDATA_SERP_ZONE=serp_api1
# Mode B — Proxy credentials (instead of the token above):
# BRIGHTDATA_PROXY=https://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:<port>
# Optional Scraping Browser endpoint for JS-rendered pages:
# BRIGHTDATA_BROWSER_WSS=wss://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:9222

# --- Additional scraper providers (optional; enable them in Settings) ---
SCRAPEDO_API_TOKEN=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Self-hosted free stack; both URLs are required for this provider.
SEARXNG_BASE_URL=
CRAWL4AI_BASE_URL=

# --- OpenAI (live claim extraction; optional, demo runs offline without it) ---
OPENAI_API_KEY=

# --- OpenRouter (powers the AI agent chat) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# --- AI agent rate limit (public deploy; optional, default 100) ---
# Global cap on AI messages per day to bound API cost. The dashboard and all
# data are never limited — only the AI agent.
AGENT_DAILY_LIMIT=100

# --- Persistent runtime data (optional) ---
# Railway automatically supplies RAILWAY_VOLUME_MOUNT_PATH when a volume is
# attached. Set this only when using another persistent directory.
# POLYFINTECH_DATA_DIR=/data
# CHAT_HISTORY_DB_PATH=/data/chat_history.sqlite3
